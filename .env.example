# ─────────────────────────────────────────────────────────────────────────────
# Voyage Travel Planner — environment configuration
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite by default — file lives in /prisma)
DATABASE_URL="file:./dev.db"

# ── Anthropic (Claude) — AI Travel Consultant ───────────────────────────────
# Used by the Itinerary Analyzer and Smart Packing Assistant.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ── Google Maps Platform ────────────────────────────────────────────────────
# One key, with these APIs enabled in Google Cloud Console:
#   - Maps JavaScript API   (render the custom per-trip map)
#   - Places API            (location search, place details, "Saved Places")
#   - Geocoding API         (resolve addresses <-> coordinates)
# Browser key (referer-restricted) used by the client map component:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."
# Server key (IP-restricted) used by server-side Places/Geocoding routes:
GOOGLE_MAPS_SERVER_API_KEY="AIza..."

# ── Flight Tracking ─────────────────────────────────────────────────────────
# Live departure/arrival times, delays, terminals, gates.
# Default provider: Aviationstack (https://aviationstack.com/)
# Alternatives: FlightAware AeroAPI, AviationEdge — see README "API Integrations".
AVIATIONSTACK_API_KEY=""

# ── Google Gemini / Imagen ───────────────────────────────────────────────────
# Used to auto-generate trip cover images when a new trip is created.
# Get your key at: https://aistudio.google.com/app/apikey
# Requires "Generative Language API" enabled in your Google Cloud project.
GOOGLE_GEMINI_API_KEY=""
